mobile/*.iml
# 【FEAT-366 hotfix 2026-05-27】mobile/pubspec.lock の除外を撤廃。
# Flutter 公式は Application プロジェクトでは pubspec.lock の commit を推奨
# (https://dart.dev/tools/pub/glossary#lockfile)。Sabiowl は Application のため
# commit して再現性のあるビルド + CI/CD 信頼性 + サプライチェーン攻撃対策を確保。
# Render は backend/ のみ deploy するため pubspec.lock の commit による影響なし。

# claude
.claude/worktrees/

# PixelLab 調達残骸 (FEAT-302 / FEAT-305 で確立、2026-05-25)
# Sprite 採用版は mobile/assets/images/battle/ or mobile/assets/images/npc/ に
# 個別配置、_variants/ に退避。zip ダウンロードや UUID 名一時 jpg は
# リポジトリに含めない方針 (バイナリ容量節約 + 可読性維持)。
mobile/assets/images/characters/pixcel_lab/
mobile/assets/images/*.jpg
*.zip
# 【FEAT-320 追加 (2026-05-27)】PixelLab zip 展開フォルダ (キャラ別 prompt 名で命名)。
# sprite 採用版は battle/ や sabi/ 配下に enemy_*.png / sabi_unified.png として直接
# 配置するため、PixelLab 自動生成の展開フォルダは不要。
mobile/assets/images/**/HUGE_*/

# 機密
doc/instructions_from_gemini/

# ローカル専用スクリプト (個人環境固有、team 共有不要)
# 【2026-07-08 追加】scripts/run-prod-android.ps1 は個人端末で prod backend
# 向け Android 実機ビルドを叩くためのローカル用途スクリプト。
# 端末固有の path や環境変数を含む可能性があるため team 共有せず、
# git rm --cached で追跡解除済 + 本エントリで以降の再追跡防止。
scripts/run-prod-android.ps1
scripts/run-dev-android.ps1

# Claude Code / セッション tempfile (2026-07-26 追加)
# 【背景】ed05ca1 doc更新 コミットで broad `git add` により scratchpad/ 配下の
# session tempfile 10 本 (commit_msg 下書き + fire_frame_*.png 等) が誤 sweep-in、
# release merge 準備時に発覚 → git rm --cached で untrack + 本エントリで以降の
# 再追跡防止。scratchpad/ はセッションローカル、team 共有・repo 保管どちらも不要。
scratchpad/

