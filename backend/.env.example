# ============================================================
# Sabiowl 環境変数テンプレート
# このファイルをコピーして .env を作成してください:
#   cp .env.example .env
# ============================================================

# ── Django 基本設定 ──────────────────────────────────────────
# 本番では必ず長くランダムな値に変更してください
# 生成コマンド: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=__GENERATE_WITH_secrets.token_urlsafe(50)__

# ローカル開発: True  /  本番: False
DEBUG=True

# 本番時に自分のドメインを追加 (カンマ区切り)
# 例: ALLOWED_HOSTS=sabiowl.com,www.sabiowl.com
ALLOWED_HOSTS=localhost,127.0.0.1


# ── データベース ────────────────────────────────────────────
# 【2026-07-06 制定】ローカル開発は SQLite fallback を default 運用
#
# .env に DATABASE_URL は **書かない**。settings.py:118-158 の SQLite fallback
# (backend/db.sqlite3) が自動使用される。
#
# 理由:
# - Neon に一切繋がらない = accidental migrate の物理的不可能化
# - test 実行時に Neon 上に test_neondb を作らない (Neon 側後片付け不要)
# - CI (GitHub Actions) と同じ環境 = 挙動一致
#
# Prod-like 検証が必要な場合のみ、その場だけ PowerShell の一時 env で上書き:
#   $env:DATABASE_URL = 'postgresql://neondb_owner:xxx@ep-DEV-YYY-pooler.../neondb?...'
#   python manage.py shell   # 明示的に dev を触る意図
# shell を閉じれば env は消えるため、露出は瞬間的。
#
# 本番 (Render prod / dev) は Render Dashboard 側の env var で個別設定済み、
# .env は無関係。
#
# DATABASE_URL_DIRECT も同様に **書かない**。
# Neon の Pooled (PgBouncer) 経由では migrate の advisory lock が制約されるため、
# build.sh が Direct 接続文字列を使って migrate する:
#   DATABASE_URL="${DATABASE_URL_DIRECT:-$DATABASE_URL}" python manage.py migrate
# 未設定なら DATABASE_URL にフォールバックするので、ローカルでは不要。
#
# 詳細: CLAUDE.md「Local .env は DATABASE_URL を削除して SQLite fallback を
# default 運用」 + doc/postmortem/20260706_prod_db_schema_drift.md 参照。


# 【SEC-15 L-01 (2026-05-30)】MAGIC_LINK_BASE_URL 設定は撤去。
# FEAT-178 で MagicLink 経路を完全撤去済のため不要。


# ── メール送信 (Resend) ─────────────────────────────────────
#
# [ローカル開発] コンソール出力（メールは実際には送信しない）
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Sabiowl <noreply@sabiowl.com>
#
# [本番] Resend SMTP を使う場合は以下を有効にして上の2行をコメントアウト
#
# 手順:
#   1. https://resend.com でアカウント作成
#   2. API Keys ページで新しいキーを発行 (re_xxxx...)
#   3. Domains ページで送信元ドメインを追加・DNS 認証
#   4. 認証前のテスト用送信元: onboarding@resend.dev (Resend 提供)
#
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DEFAULT_FROM_EMAIL=Sabiowl <noreply@sabiowl.com>
#
# SMTP 接続タイムアウト (秒)。既定 15。
# Gunicorn の worker timeout より短くして、メール送信のハングで worker が
# 道連れになるのを防ぐ意図の値なので、伸ばすときは worker 側も見ること。
# EMAIL_TIMEOUT=15


# ── お問い合わせメール (Resend HTTP API) ─────────────────────
#
# 【FEAT-395 (2026-05-31)】お問い合わせ送信は SMTP ではなく Resend の
# HTTP API を使う。旧 SMTP (smtp.resend.com:587) は Render 環境で TCP 接続
# timeout が多発したため構造的に切り替えた経緯がある。
#
# ローカルで「お問い合わせ」機能を動かす場合のみ設定する。
# 未設定でもアプリは起動する (送信時にエラーになるだけ)。
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# 問い合わせの宛先。未設定なら support@sabiowl.com。
# 「Resend のドメイン認証が済むまでは運営 Gmail 宛」のような切り替えを
# コード変更なしで行うために環境変数化されている。
# CONTACT_TO_EMAIL=support@sabiowl.com


# ── Firebase Cloud Messaging（本番のみ） ─────────────────────
# サービスアカウント JSON 全体を貼り付け
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}


# ── 開発用ワンタップログイン（ローカル限定） ──────────────────
# DEBUG=True + SQLite + DEV_LOGIN_ENABLED=true の三重条件成立時のみ動作
# 本番（Render）では絶対に設定しないこと
DEV_LOGIN_ENABLED=true


# ── 管理画面の 2 要素認証 ───────────────────────────────────
#
# /admin/ へのログイン後にワンタイムコード (メール送信) を要求する。
# **既定は True** なので、未設定だとローカルでも MFA が要求される。
# ローカルで管理画面を使うなら false にする (DEBUG=True のときのみ bypass 可)。
#
# 真実値: api/middleware/admin_mfa.py + api/views/admin_mfa.py
ADMIN_MFA_REQUIRED=false
#
# MFA 通過後のセッション保持時間 (秒)。既定 43200 (12 時間)。
# ADMIN_MFA_SESSION_SECONDS=1800


# ── DB 接続オプション ───────────────────────────────────────
#
# PostgreSQL の sslmode。既定 require。
# DATABASE_URL を設定して PostgreSQL に繋ぐ場合のみ意味を持つ
# (未設定なら SQLite fallback なので無関係)。
# ローカルの平文 PostgreSQL に繋ぐときだけ prefer / disable にする。
# DB_SSL_MODE=prefer


# ── セキュリティ (DEBUG=False のときのみ有効) ────────────────
#
# HTTP を HTTPS にリダイレクトする。既定 True。
# 本番 Render は proxy 側で HTTPS 終端しているのでこのままでよい。
# HTTP で疎通確認したい CI / 検証環境でのみ False にする
# (実際 .github/workflows/ci.yml は False を注入している)。
# SECURE_SSL_REDIRECT=True


# ── 課金 (RevenueCat、本番のみ) ─────────────────────────────
#
# webhook 受信時に Authorization ヘッダーと照合する共有シークレット。
# **未設定だと webhook が 500 を返して fail-closed になる** (意図的な設計)。
# ローカルでは webhook を受けないため設定不要。
# REVENUECAT_WEBHOOK_AUTH=<RevenueCat dashboard で設定した任意の文字列>
#
# RevenueCat REST API キー (購読状態の照会用)。
# REVENUECAT_REST_API_KEY=<RevenueCat dashboard で発行>


# ── エラー監視 (Sentry、本番のみ) ───────────────────────────
#
# 未設定、または DEBUG=True のときは Sentry 初期化を skip する。
# ローカルでは設定しないこと (開発中の例外が本番プロジェクトに混ざる)。
# SENTRY_DSN_BACKEND=https://xxxxxxxx@oXXXXXX.ingest.sentry.io/XXXXXXX
#
# 【FEAT-536 (2026-08-28)】環境の呼び名。未設定なら 'production'。
# 🔴 dev の Render サービスには必ず 'dev' を設定すること。
# 旧実装は 'production' のハードコードで、dev を DEBUG=False にした瞬間に
# dev のエラーが prod のストリームへ混ざる構造だった。
# SENTRY_ENVIRONMENT=dev


# ── ログ出力レベル (任意) ───────────────────────────────────
#
# 【FEAT-536 (2026-08-28)】未設定でよい。ノイズが増えたときに Render 側で
# 設定すれば、デプロイなしで絞れる。
#
# DJANGO_LOG_LEVEL: Django 本体 (django.request の 4xx/5xx を含む)。既定 WARNING。
# API_LOG_LEVEL   : このプロジェクトの api.* ロガー。既定 INFO。
# DJANGO_LOG_LEVEL=WARNING
# API_LOG_LEVEL=INFO


# ── 管理画面 URL の秘匿 (defense in depth) ──────────────────
#
# /admin/ のパスを予測困難な値に変更する。未設定なら 'admin/'。
# 末尾のスラッシュまで含めて指定すること。
# 本番 (Render) では設定を推奨。ローカルは既定のままでよい。
# ADMIN_URL=hg-admin-xxxxxxxx/


# ── プロダクト分析 (PostHog) ────────────────────────────────
#
# [イベント送信] 未設定なら送信処理は no-op になる (ローカルは未設定でよい)。
# POSTHOG_API_KEY は Flutter ビルドの --dart-define と **同じ値** を使う。
# POSTHOG_API_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# POSTHOG_HOST=https://us.i.posthog.com
#
# [アカウント削除時の PostHog 側データ削除] (FEAT-245)
# 未設定なら削除処理を skip する (アカウント削除自体は成功する)。
#
# POSTHOG_PERSONAL_API_KEY は 2 軸の認可が必要で、どちらか片方でも欠けると 403:
#   1. Scope に person:write
#   2. Organization & project access に対象プロジェクトを明示許可
#      (新しい Scoped Personal API Key は既定が空 = どのプロジェクトにも触れない)
# POSTHOG_PERSONAL_API_KEY=phx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# POSTHOG_PROJECT_ID=12345
